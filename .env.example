# API Key de Google
GOOGLE_API_KEY=tu_api_key_aqui

# ElevenLabs TTS
# Obtén tu API key en: https://elevenlabs.io (Perfil -> API Keys)
# El Voice ID lo encuentras en: https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=tu_api_elevenlabs_aqui
ELEVENLABS_VOICE_ID=tu_voice_id_aqui

# WhatsApp Configuration
WHATSAPP_ENABLED=true
WHATSAPP_HEADLESS=true
WHATSAPP_SESSION_PATH=./server/data/whatsapp-session